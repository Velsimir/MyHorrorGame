%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 928545dc5ece41e4b9fcad6829c3378f, type: 3}
  m_Name: StringTable_SimpleDialogue
  m_EditorClassIdentifier: Velsi.Typecraft.Runtime::Velsi.Typecraft.Text.Tables.StringTable
  _tableId: SimpleDialogue
  _entries:
  - _key: sample.greeting
    _comment: "\u041F\u0435\u0440\u0432\u0430\u044F \u0440\u0435\u043F\u043B\u0438\u043A\u0430:
      \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A-\u0441\u0442\u0438\u043B\u044C
      \u0438 \u0441\u0432\u043E\u0439 \u0442\u0435\u0433 {player:name}"
    _values:
    - _locale: en
      _text: 'Lighthouse

        Hello, {player:name}. The keeper left hours ago.'
    - _locale: ru
      _text: "\u041C\u0430\u044F\u043A\n\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
        {player:name}. \u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044C
        \u0443\u0448\u0451\u043B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0447\u0430\u0441\u043E\u0432 \u043D\u0430\u0437\u0430\u0434."
    - _locale: zh-Hans
      _text: "\u706F\u5854\n\u4F60\u597D\uFF0C{player:name}\u3002\u770B\u5B88\u4EBA\u51E0\u4E2A\u5C0F\u65F6\u524D\u5C31\u79BB\u5F00\u4E86\u3002"
  - _key: sample.lamp
    _comment: "\u042D\u0444\u0444\u0435\u043A\u0442 TMPEffects \u0438 \u043F\u0430\u0443\u0437\u0430
      \u043C\u0430\u0448\u0438\u043D\u043A\u0438"
    _values:
    - _locale: en
      _text: "The lamp is still burning\u2026 who lit it?"
    - _locale: ru
      _text: "\u041B\u0430\u043C\u043F\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451
        \u0433\u043E\u0440\u0438\u0442\u2026 \u043A\u0442\u043E \u0435\u0451 \u0437\u0430\u0436\u0451\u0433?"
    - _locale: zh-Hans
      _text: "\u706F\u8FD8\u4EAE\u7740\u2026\u2026\u662F\u8C01\u70B9\u7684\uFF1F"
  - _key: sample.hint
    _comment: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 \u0432\u0432\u043E\u0434\u0430:
      \u0433\u043B\u0438\u0444 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u043C"
    _values:
    - _locale: en
      _text: Press {key:Interact} to take the lamp.
    - _locale: ru
      _text: "\u041D\u0430\u0436\u043C\u0438 {key:Interact}, \u0447\u0442\u043E\u0431\u044B
        \u0432\u0437\u044F\u0442\u044C \u043B\u0430\u043C\u043F\u0443."
    - _locale: zh-Hans
      _text: "\u6309 {key:Interact} \u62FF\u8D77\u706F\u3002"
  - _key: sample.whisper
    _comment: "\u0421\u0442\u0438\u043B\u044C \u0448\u0451\u043F\u043E\u0442\u0430"
    _values:
    - _locale: en
      _text: Don't turn around.
    - _locale: ru
      _text: "\u041D\u0435 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044F."
    - _locale: zh-Hans
      _text: "\u522B\u56DE\u5934\u3002"
  - _key: sample.door
    _comment: "\u0421\u0442\u0438\u043B\u044C \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F"
    _values:
    - _locale: en
      _text: The door behind you is open.
    - _locale: ru
      _text: "\u0414\u0432\u0435\u0440\u044C \u0437\u0430 \u0442\u0432\u043E\u0435\u0439
        \u0441\u043F\u0438\u043D\u043E\u0439 \u043E\u0442\u043A\u0440\u044B\u0442\u0430."
    - _locale: zh-Hans
      _text: "\u4F60\u8EAB\u540E\u7684\u95E8\u5F00\u7740\u3002"
