  m_Script: {fileID: 11500000, guid: 9f8b4545da39f464a992a9ba35efe66c, type: 3}
  m_Name: MarkupLayer_BranchingDialogue
  m_EditorClassIdentifier: Velsi.Typecraft.Runtime::Velsi.Typecraft.Text.MarkupLayer
  _tableId: BranchingDialogue
  _entries:
  - _key: keeper.door
    _locale: en
    _markup: Fine. It's [warn]open[/warn]. Don't say I didn't warn you.
    _source: Fine. It's open. Don't say I didn't warn you.
  - _key: keeper.door
    _locale: ru
    _markup: "\u041B\u0430\u0434\u043D\u043E. \u041E\u043D\u0430 [warn]\u043E\u0442\u043A\u0440\u044B\u0442\u0430[/warn].
      \u041D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438, \u0447\u0442\u043E \u044F
      \u043D\u0435 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B."
    _source: "\u041B\u0430\u0434\u043D\u043E. \u041E\u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430.
      \u041D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438, \u0447\u0442\u043E \u044F
      \u043D\u0435 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B."
  - _key: keeper.door
    _locale: zh-Hans
    _markup: "\u597D\u5427\u3002\u95E8[warn]\u5F00\u4E86[/warn]\u3002\u522B\u8BF4\u6211\u6CA1\u8B66\u544A\u8FC7\u4F60\u3002"
    _source: "\u597D\u5427\u3002\u95E8\u5F00\u4E86\u3002\u522B\u8BF4\u6211\u6CA1\u8B66\u544A\u8FC7\u4F60\u3002"
  - _key: note.text
    _locale: en
    _markup: "[whisper]If the lamp is burning, do not open the door.[/whisper] \u2014
      K."
    _source: "If the lamp is burning, do not open the door. \u2014 K."
  - _key: note.text
    _locale: ru
    _markup: "[whisper]\u0415\u0441\u043B\u0438 \u043B\u0430\u043C\u043F\u0430 \u0433\u043E\u0440\u0438\u0442
      \u2014 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439 \u0434\u0432\u0435\u0440\u044C.[/whisper]
      \u2014 \u041A."
    _source: "\u0415\u0441\u043B\u0438 \u043B\u0430\u043C\u043F\u0430 \u0433\u043E\u0440\u0438\u0442
      \u2014 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439 \u0434\u0432\u0435\u0440\u044C.
      \u2014 \u041A."
  - _key: note.text
    _locale: zh-Hans
    _markup: "[whisper]\u706F\u4EAE\u7740\u7684\u65F6\u5019\uFF0C\u4E0D\u8981\u5F00\u95E8\u3002[/whisper]\u2014\u2014K"
    _source: "\u706F\u4EAE\u7740\u7684\u65F6\u5019\uFF0C\u4E0D\u8981\u5F00\u95E8\u3002\u2014\u2014K"
  - _key: eli.thought
    _locale: en
    _markup: '[whisper]Cold in here.<!wait=0.4> Someone was here a minute ago.[/whisper]'
    _source: Cold in here. Someone was here a minute ago.
  - _key: eli.thought
    _locale: ru
    _markup: "[whisper]\u0417\u0434\u0435\u0441\u044C \u0445\u043E\u043B\u043E\u0434\u043D\u043E.<!wait=0.4>
      \u041A\u0442\u043E-\u0442\u043E \u0431\u044B\u043B \u0442\u0443\u0442 \u043C\u0438\u043D\u0443\u0442\u0443
      \u043D\u0430\u0437\u0430\u0434.[/whisper]"
    _source: "\u0417\u0434\u0435\u0441\u044C \u0445\u043E\u043B\u043E\u0434\u043D\u043E.
      \u041A\u0442\u043E-\u0442\u043E \u0431\u044B\u043B \u0442\u0443\u0442 \u043C\u0438\u043D\u0443\u0442\u0443
      \u043D\u0430\u0437\u0430\u0434."
  - _key: eli.thought
    _locale: zh-Hans
    _markup: "[whisper]\u8FD9\u91CC\u597D\u51B7\u3002<!wait=0.4>\u521A\u624D\u8FD8\u6709\u4EBA\u5728\u3002[/whisper]"
    _source: "\u8FD9\u91CC\u597D\u51B7\u3002\u521A\u624D\u8FD8\u6709\u4EBA\u5728\u3002"
  - _key: keeper.greet_note
    _locale: en
    _markup: You went upstairs. You <shake>read it</shake>, didn't you?
    _source: You went upstairs. You read it, didn't you?
  - _key: keeper.greet_note
    _locale: ru
    _markup: "\u0422\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0441\u044F
      \u043D\u0430\u0432\u0435\u0440\u0445. \u0422\u044B \u0435\u0451 <shake>\u043F\u0440\u043E\u0447\u0451\u043B</shake>,
      \u0434\u0430?"
    _source: "\u0422\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0441\u044F
      \u043D\u0430\u0432\u0435\u0440\u0445. \u0422\u044B \u0435\u0451 \u043F\u0440\u043E\u0447\u0451\u043B,
      \u0434\u0430?"
  - _key: keeper.greet_note
    _locale: zh-Hans
    _markup: "\u4F60\u4E0A\u697C\u4E86\u3002\u4F60<shake>\u8BFB\u8FC7\u4E86</shake>\uFF0C\u5BF9\u5427\uFF1F"
    _source: "\u4F60\u4E0A\u697C\u4E86\u3002\u4F60\u8BFB\u8FC7\u4E86\uFF0C\u5BF9\u5427\uFF1F"
