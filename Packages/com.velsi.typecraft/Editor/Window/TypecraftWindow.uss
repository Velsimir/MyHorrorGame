.tc-root {
    flex-grow: 1;
    background-color: rgb(56, 56, 56);
}

.tc-tabs {
    flex-direction: row;
    flex-shrink: 0;
    background-color: rgb(35, 35, 35);
    border-bottom-width: 1px;
    border-bottom-color: rgb(25, 25, 25);
    padding: 2px 4px 0 4px;
}

.tc-tabs__tab {
    margin: 0 2px 0 0;
    padding: 3px 12px;
    border-radius: 3px 3px 0 0;
    border-width: 0;
    background-color: transparent;
    color: rgb(150, 150, 150);
}

.tc-tabs__tab--on {
    background-color: rgb(56, 56, 56);
    color: rgb(220, 220, 220);
    border-top-width: 2px;
    border-top-color: rgb(77, 143, 209);
}

.tc-body {
    flex-grow: 1;
}

.tc-placeholder {
    margin: 40px;
    -unity-text-align: middle-center;
    color: rgb(140, 140, 140);
    font-size: 14px;
}

.tc-editor {
    flex-grow: 1;
}

.tc-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 3px 6px;
    background-color: rgb(60, 60, 60);
    border-bottom-width: 1px;
    border-bottom-color: rgb(31, 31, 31);
}

.tc-toolbar__target {
    max-width: 320px;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-style: bold;
    margin-right: 6px;
}

.tc-toolbar__lock {
    margin-right: 6px;
}

.tc-toolbar__lock > Label {
    min-width: 0;
    margin-right: 2px;
}

.tc-toolbar__locale {
    min-width: 70px;
    margin-right: 6px;
}

.tc-toolbar__apply {
    background-color: rgb(61, 111, 163);
    color: rgb(240, 240, 240);
    margin-left: 6px;
}

.tc-seg {
    flex-direction: row;
    margin-right: 6px;
}

.tc-seg > Button {
    margin: 0;
    border-radius: 0;
    padding: 1px 8px;
}

.tc-seg--on {
    background-color: rgb(70, 96, 124);
}

.tc-banner {
    flex-shrink: 0;
    padding: 4px 8px;
    background-color: rgb(84, 64, 34);
    color: rgb(240, 200, 140);
    white-space: normal;
}

.tc-stage {
    flex-grow: 1;
    min-height: 160px;
    position: relative;
}

.tc-preview {
    flex-grow: 1;
}

.tc-float {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 3px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(74, 74, 74);
    background-color: rgb(42, 42, 42);
}

.tc-float > Button {
    margin: 0 1px;
    padding: 2px 8px;
    min-width: 30px;
    background-color: rgb(52, 52, 52);
    color: rgb(230, 230, 230);
    border-width: 0;
    -unity-font-style: normal;
}

.tc-float > Button:hover {
    background-color: rgb(62, 90, 120);
}

.tc-float__color {
    width: 46px;
    margin: 0 3px;
}

.tc-chips {
    position: absolute;
    left: 6px;
    bottom: 6px;
    right: 6px;
    flex-direction: row;
    flex-wrap: wrap;
}

.tc-chip {
    margin: 0 4px 4px 0;
    padding: 1px 8px;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgb(77, 143, 209);
    background-color: rgba(30, 52, 76, 0.9);
    color: rgb(220, 230, 240);
    font-size: 11px;
}

.tc-chip--auto {
    border-color: rgb(197, 134, 192);
    background-color: rgba(70, 40, 72, 0.9);
}

.tc-chip:hover {
    background-color: rgb(120, 52, 46);
    border-color: rgb(211, 106, 92);
}

.tc-tag {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 280px;
    padding: 6px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(74, 74, 74);
    background-color: rgb(42, 42, 42);
}

.tc-tag__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

#tc-tag__title {
    flex-grow: 1;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
}

.tc-tag__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

#tc-tag__label {
    width: 64px;
    color: rgb(170, 170, 170);
}

.tc-tag__slider {
    flex-grow: 1;
    margin: 0 4px 0 0;
}

.tc-tag__number {
    width: 52px;
    margin: 0;
}

.tc-tag__text {
    flex-grow: 1;
    margin: 0;
}

.tc-tag__add {
    margin: 4px 0 0 0;
}

.tc-markup {
    flex-shrink: 0;
    height: 92px;
    overflow: hidden;
    border-top-width: 1px;
    border-top-color: rgb(31, 31, 31);
    position: relative;
}

.tc-markup__field {
    flex-grow: 1;
    height: 100%;
    margin: 0;
    --unity-cursor-color: rgb(255, 255, 255);
    --unity-selection-color: rgba(77, 140, 217, 0.45);
}

.tc-markup__field > .unity-text-field__input,
.tc-markup__field .unity-base-text-field__input {
    background-color: rgb(42, 42, 42);
    border-width: 0;
    font-size: 12px;
    padding: 6px 10px;
    white-space: normal;
}

.tc-markup__text {
    color: rgba(0, 0, 0, 0);
}

.tc-markup__clip {
    position: absolute;
    overflow: hidden;
}

.tc-markup__highlight {
    position: absolute;
    font-size: 12px;
    color: rgb(212, 212, 212);
    white-space: normal;
    padding: 0;
    margin: 0;
}

.tc-suggest {
    position: absolute;
    min-width: 240px;
    background-color: rgb(37, 37, 38);
    border-width: 1px;
    border-color: rgb(69, 69, 69);
}

.tc-suggest__row {
    padding: 2px 8px;
}

.tc-suggest__row--selected {
    background-color: rgb(4, 57, 94);
}

.tc-drawer {
    flex-shrink: 0;
    height: 150px;
    border-top-width: 1px;
    border-top-color: rgb(31, 31, 31);
}

.tc-drawer__tabs {
    flex-direction: row;
    align-items: center;
    background-color: rgb(35, 35, 35);
}

.tc-drawer__tab {
    padding: 4px 14px;
    color: rgb(143, 143, 143);
    border-right-width: 1px;
    border-right-color: rgb(31, 31, 31);
}

.tc-drawer__tab--on {
    background-color: rgb(56, 56, 56);
    color: rgb(220, 220, 220);
    border-top-width: 2px;
    border-top-color: rgb(77, 143, 209);
}

.tc-drawer__filter {
    width: 180px;
    margin-left: auto;
}

.tc-drawer__content {
    flex-grow: 1;
}

.tc-drawer__content > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-direction: row;
    padding: 6px;
}

.tc-drawer__grid {
    flex-wrap: wrap;
}

.tc-card {
    width: 132px;
    margin-right: 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(27, 27, 27);
    background-color: rgb(20, 21, 22);
    overflow: hidden;
}

.tc-card:hover {
    border-color: rgb(77, 143, 209);
}

.tc-card--applied {
    border-width: 2px;
    border-color: rgb(110, 190, 120);
}

.tc-card--partial {
    border-width: 2px;
    border-color: rgb(200, 170, 80);
}

.tc-card__image {
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    justify-content: center;
}

#tc-card__big {
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgb(156, 220, 254);
}

.tc-card--show #tc-card__big {
    color: rgb(127, 216, 196);
}

.tc-card--hide #tc-card__big {
    color: rgb(220, 184, 98);
}

.tc-card--command #tc-card__big {
    color: rgb(197, 134, 192);
}

.tc-card--add #tc-card__big {
    color: rgb(150, 150, 150);
}

.tc-card__footer {
    flex-direction: row;
    justify-content: space-between;
    padding: 2px 5px;
}

#tc-card__title {
    color: rgb(220, 184, 98);
    font-size: 10px;
}

#tc-card__subtitle {
    color: rgb(143, 143, 143);
    font-size: 10px;
}

.tc-icon {
    width: 52px;
    height: 58px;
    margin: 0 4px 4px 0;
    padding-bottom: 12px;
    border-radius: 3px;
    background-color: rgb(20, 21, 22);
    -unity-background-scale-mode: scale-to-fit;
    justify-content: center;
}

.tc-icon:hover {
    background-color: rgb(46, 60, 76);
}

.tc-icon #missing {
    -unity-text-align: middle-center;
    color: rgb(211, 106, 92);
    font-size: 18px;
}

.tc-icon__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    font-size: 9px;
    -unity-text-align: middle-center;
    color: rgb(150, 150, 150);
    overflow: hidden;
}

.tc-status {
    flex-direction: row;
    flex-shrink: 0;
    padding: 3px 8px;
    background-color: rgb(35, 35, 35);
    border-top-width: 1px;
    border-top-color: rgb(31, 31, 31);
    color: rgb(143, 143, 143);
}

.tc-status > Label {
    margin-right: 14px;
}

.tc-status__warn {
    color: rgb(224, 164, 60);
}

.tc-loc {
    flex-grow: 1;
}

.tc-loc__table {
    min-width: 120px;
    margin-right: 2px;
}

.tc-loc__search {
    width: 180px;
    margin-left: 8px;
}

.tc-loc__filter {
    min-width: 150px;
}

.tc-loc__body {
    flex-grow: 1;
}

.tc-loc__grid-host {
    flex-grow: 1;
    min-height: 120px;
}

.tc-loc__grid {
    flex-grow: 1;
}

.tc-loc__cell {
    flex-grow: 1;
    padding: 2px 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.tc-loc__cell--selected {
    background-color: rgba(77, 143, 209, 0.35);
}

.tc-loc__cell--missing {
    color: rgb(211, 106, 92);
    background-color: rgba(211, 106, 92, 0.12);
}

.tc-loc__cell--overflow {
    border-left-color: rgb(224, 164, 60);
}

.tc-loc__cell--glyph {
    border-left-color: rgb(197, 134, 192);
}

.tc-loc__cell--mismatch {
    border-left-color: rgb(86, 156, 214);
}

.tc-loc__cell--warn {
    color: rgb(224, 164, 60);
}

.tc-loc__cell--stale {
    color: rgb(255, 196, 120);
    background-color: rgba(224, 130, 40, 0.28);
    border-left-color: rgb(240, 140, 40);
    border-left-width: 4px;
}

.tc-loc__sync {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 3px 8px;
    background-color: rgb(48, 64, 82);
}

.tc-loc__sync-label {
    flex-grow: 1;
}

.tc-loc__hint {
    white-space: normal;
    color: rgb(224, 164, 60);
    margin: 2px 0 2px 0;
}

.tc-loc__layer {
    margin-top: 6px;
    padding: 4px 6px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    border-radius: 3px;
}

.tc-loc__layer--stale {
    background-color: rgba(224, 130, 40, 0.16);
    border-color: rgb(240, 140, 40);
    border-width: 2px;
}

.tc-loc__layer-title {
    flex-grow: 1;
    -unity-font-style: bold;
}

.tc-loc__layer--stale .tc-loc__layer-title {
    color: rgb(255, 180, 90);
}

.tc-loc__diff {
    white-space: normal;
    font-size: 13px;
    margin: 2px 0 2px 0;
}

.tc-loc__layer-markup {
    white-space: normal;
    color: rgb(160, 160, 160);
    margin-top: 2px;
}

.tc-loc__cell-panel {
    flex-direction: row;
    flex-shrink: 0;
    height: 230px;
    border-top-width: 1px;
    border-top-color: rgb(31, 31, 31);
}

.tc-loc__cell-editor {
    flex-grow: 1;
    flex-basis: 0;
    padding: 4px 6px;
}

.tc-loc__cell-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.tc-loc__cell-title {
    flex-grow: 1;
    -unity-font-style: bold;
}

.tc-loc__base {
    color: rgb(143, 143, 143);
    white-space: normal;
    margin-bottom: 4px;
}

.tc-loc__comment {
    margin: 4px 0 0 0;
}

.tc-loc__preview {
    flex-grow: 1;
    flex-basis: 0;
    border-left-width: 1px;
    border-left-color: rgb(31, 31, 31);
}

.tc-loc__setup {
    margin: 30px;
    max-width: 560px;
}

.tc-loc__setup > Label {
    white-space: normal;
    margin-bottom: 10px;
    color: rgb(190, 190, 190);
}

#tc-loc__empty {
    margin: 30px;
    color: rgb(140, 140, 140);
}

.tc-lib,
.tc-fonts {
    flex-grow: 1;
}

.tc-lib__body {
    flex-grow: 1;
    flex-direction: row;
}

.tc-lib__list {
    width: 220px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: rgb(35, 35, 35);
    background-color: rgb(48, 48, 48);
}

.tc-lib__section {
    margin: 8px 8px 2px 8px;
    font-size: 10px;
    color: rgb(150, 150, 150);
    -unity-font-style: bold;
}

.tc-lib__item {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 8px;
}

.tc-lib__item:hover {
    background-color: rgb(62, 62, 62);
}

.tc-lib__item--selected {
    background-color: rgba(77, 143, 209, 0.35);
}

.tc-lib__item #note {
    color: rgb(140, 140, 140);
}

.tc-lib__detail {
    flex-grow: 1;
}

.tc-lib__panel {
    flex-grow: 1;
    padding: 6px 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.tc-lib__panel--drop {
    border-color: rgb(77, 143, 209);
    background-color: rgba(77, 143, 209, 0.08);
}

.tc-lib__header,
.tc-lib__row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.tc-lib__title {
    flex-grow: 1;
    -unity-font-style: bold;
    font-size: 13px;
    margin: 2px 0 4px 0;
}

.tc-lib__hint,
#tc-fonts__hint {
    color: rgb(150, 150, 150);
    white-space: normal;
    margin-bottom: 6px;
}

.tc-lib__icons {
    flex-grow: 1;
}

.tc-lib__icons-content {
    flex-direction: row;
    flex-wrap: wrap;
}

.tc-icon--selected {
    border-width: 2px;
    border-color: rgb(77, 143, 209);
}

.tc-lib__icon-details {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgb(35, 35, 35);
}

.tc-lib__icon-key {
    width: 260px;
}

.tc-lib__fit {
    width: 100%;
    flex-direction: row;
    margin-top: 4px;
}

.tc-lib__fit-sliders {
    width: 320px;
    flex-shrink: 0;
}

.tc-lib__fit-sliders > Slider .unity-base-field__label {
    min-width: 120px;
}

.tc-icon-line {
    flex-grow: 1;
    height: 110px;
    min-width: 200px;
    margin-left: 6px;
}

.tc-check {
    padding: 8px 10px;
}

#tc-check__problem {
    white-space: normal;
    color: rgb(230, 170, 90);
    margin-bottom: 2px;
}

.tc-check .tc-icon-line {
    flex-grow: 1;
    margin: 6px 0;
}

.tc-check__buttons {
    justify-content: flex-end;
}

#tc-lib__placeholder,
#tc-lib__empty {
    color: rgb(150, 150, 150);
    margin: 6px;
}

.tc-lib__form {
    flex-grow: 1;
}

.tc-lib__preview {
    flex-shrink: 0;
    height: 170px;
    border-top-width: 1px;
    border-top-color: rgb(35, 35, 35);
    padding-top: 4px;
}

.tc-lib__preview > IMGUIContainer {
    flex-grow: 1;
}

.tc-fonts__grid {
    flex-grow: 1;
}

.tc-fonts__row {
    flex-direction: row;
    align-items: stretch;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 45, 45);
}

.tc-fonts__row--header {
    background-color: rgb(50, 50, 50);
    -unity-font-style: bold;
}

.tc-fonts__row--selected {
    background-color: rgba(77, 143, 209, 0.18);
}

.tc-fonts__role-cell {
    width: 130px;
    flex-shrink: 0;
    padding: 4px 8px;
    -unity-text-align: middle-left;
}

.tc-fonts__cell {
    width: 210px;
    flex-shrink: 0;
    padding: 3px 4px;
    border-left-width: 1px;
    border-left-color: rgb(45, 45, 45);
}

.tc-fonts__status {
    flex-direction: row;
    align-items: center;
    min-height: 18px;
}

.tc-fonts__status #inherited {
    color: rgb(140, 140, 140);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 4px;
}

.tc-fonts__ok {
    color: rgb(120, 180, 110);
}

.tc-fonts__missing {
    color: rgb(197, 134, 192);
    -unity-font-style: bold;
}

.tc-fonts__bottom {
    flex-direction: row;
    flex-shrink: 0;
    height: 230px;
    border-top-width: 1px;
    border-top-color: rgb(35, 35, 35);
}

.tc-fonts__build {
    width: 50%;
    padding: 6px 8px;
}

.tc-fonts__role {
    flex-grow: 1;
    padding: 6px 8px;
    border-left-width: 1px;
    border-left-color: rgb(35, 35, 35);
}

.tc-fonts__result {
    white-space: normal;
    color: rgb(170, 200, 160);
    margin-top: 4px;
}

.tc-markup-field {
    margin: 2px 3px 4px 3px;
}

.tc-markup-field__header {
    flex-direction: row;
    align-items: center;
}

.tc-markup-field__header > Button {
    width: 22px;
    height: 18px;
    padding: 0;
    margin: 0 0 0 2px;
}

.tc-markup-field__label {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.tc-markup-field__toggle--on {
    background-color: rgb(61, 111, 163);
}

.tc-markup-field .tc-markup {
    height: 58px;
}

.tc-markup-field__preview {
    height: 80px;
    margin-top: 2px;
    background-color: rgb(30, 30, 30);
}

.tc-markup-field__preview > IMGUIContainer {
    flex-grow: 1;
}

.tc-editor,
.tc-lib {
    position: relative;
}

.tc-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.tc-overlay__card {
    width: 92%;
    max-width: 980px;
    height: 88%;
    background-color: rgb(52, 52, 52);
    border-width: 1px;
    border-color: rgb(25, 25, 25);
    border-radius: 4px;
}

.tc-form {
    flex-grow: 1;
    padding: 8px 10px;
}

.tc-form__title {
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.tc-form__body {
    flex-grow: 1;
    flex-direction: row;
}

.tc-form__fields {
    width: 50%;
    min-width: 320px;
    padding-right: 8px;
}

.tc-form__side {
    flex-grow: 1;
    padding-left: 8px;
    border-left-width: 1px;
    border-left-color: rgb(35, 35, 35);
}

.tc-form__preview {
    flex-grow: 1;
    min-height: 140px;
}

.tc-form__footer {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgb(35, 35, 35);
}

.tc-form__error {
    flex-grow: 1;
    color: rgb(230, 170, 90);
    white-space: normal;
}
