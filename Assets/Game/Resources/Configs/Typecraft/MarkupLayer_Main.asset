  _entries:
  - _key: ui.door.locked
    _locale: en
    _markup: The door is [warn]locked[/warn]. <!wait=1>Press {key:Interact} to inspect
      the lock.
    _source: The door is locked. Press {key:Interact} to inspect the lock.
  - _key: ui.door.locked
    _locale: ru
    _markup: "\u0414\u0432\u0435\u0440\u044C [warn]\u0437\u0430\u043F\u0435\u0440\u0442\u0430[/warn].
      \u041D\u0430\u0436\u043C\u0438 {key:Interact}, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0437\u0430\u043C\u043E\u043A."
    _source: "\u0414\u0432\u0435\u0440\u044C \u0437\u0430\u043F\u0435\u0440\u0442\u0430.
      \u041D\u0430\u0436\u043C\u0438 {key:Interact}, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0437\u0430\u043C\u043E\u043A."
  - _key: ui.door.locked
    _locale: zh-Hans
    _markup: "\u95E8[warn]\u9501\u7740[/warn]\u3002\u6309 {key:Interact} \u68C0\u67E5\u95E8\u9501\u3002"
    _source: "\u95E8\u9501\u7740\u3002\u6309 {key:Interact} \u68C0\u67E5\u95E8\u9501\u3002"
  - _key: ui.whisper.still_here
    _locale: en
    _markup: "[whisper]It is still here\u2026[/whisper]"
    _source: "It is still here\u2026"
  - _key: ui.whisper.still_here
    _locale: ru
    _markup: "[whisper]\u041E\u043D \u0432\u0441\u0451 \u0435\u0449\u0451 \u0437\u0434\u0435\u0441\u044C\u2026[/whisper]"
    _source: "\u041E\u043D \u0432\u0441\u0451 \u0435\u0449\u0451 \u0437\u0434\u0435\u0441\u044C\u2026"
  - _key: ui.location.basement
