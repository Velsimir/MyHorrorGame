  _tableId: Main
  _entries:
  - _key: ui.door.locked
    _comment: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 \u0443 \u0437\u0430\u043F\u0435\u0440\u0442\u043E\u0439
      \u0434\u0432\u0435\u0440\u0438"
    _values:
    - _locale: en
      _text: The door is locked. Press {key:Interact} to inspect the lock.
    - _locale: ru
      _text: "\u0414\u0432\u0435\u0440\u044C \u0437\u0430\u043F\u0435\u0440\u0442\u0430.
        \u041D\u0430\u0436\u043C\u0438 {key:Interact}, \u0447\u0442\u043E\u0431\u044B
        \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0437\u0430\u043C\u043E\u043A."
    - _locale: zh-Hans
      _text: "\u95E8\u9501\u7740\u3002\u6309 {key:Interact} \u68C0\u67E5\u95E8\u9501\u3002"
  - _key: ui.whisper.still_here
    _comment: "\u0428\u0451\u043F\u043E\u0442 \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F
      \u0434\u0432\u0435\u0440\u0438"
    _values:
    - _locale: en
      _text: "It is still here\u2026"
    - _locale: ru
      _text: "\u041E\u043D \u0432\u0441\u0451 \u0435\u0449\u0451 \u0437\u0434\u0435\u0441\u044C\u2026"
  - _key: ui.location.basement
    _comment: "\u0417\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A \u043B\u043E\u043A\u0430\u0446\u0438\u0438"
    _values:
    - _locale: en
      _text: Basement
    - _locale: ru
      _text: "\u041F\u043E\u0434\u0432\u0430\u043B"
    - _locale: zh-Hans
      _text: "\u5730\u4E0B\u5BA4"
